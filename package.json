{
  "name": "skyguard",
  "version": "0.1.0",
  "private": true,
  "description": "SkyGuard — 应急疏散辅助决策原型（独立项目）",
  "scripts": {
    "setup": "npm install --prefix backend && npm install --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "npm run build --prefix backend && npm run build --prefix frontend",
    "start": "npm start --prefix backend",
    "test": "npm run test --prefix backend && npm test --prefix frontend",
    "demo": "npm run demo:safety --prefix backend",
    "bench": "npm run bench:safety --prefix backend",
    "dev": "node scripts/dev.mjs",
    "demo:mvp": "npm run demo:mvp --prefix backend",
    "experiments:mvp": "npm run experiments:mvp --prefix backend",
    "mcp": "npm run mcp --prefix backend",
    "benchmark:competition": "npm run benchmark:competition --prefix backend",
    "benchmark:v6": "npm run benchmark:v6 --prefix backend",
    "benchmark:v61": "npm run benchmark:v61 --prefix backend",
    "verify:evidence": "npm run verify:evidence --prefix backend",
    "manifest:evidence": "npm run manifest:evidence --prefix backend",
    "benchmark:v62": "npm run benchmark:v62 --prefix backend",
    "benchmark:voi-v2": "npm run benchmark:voi-v2 --prefix backend",
    "benchmark:v65": "npm run benchmark:v65 --prefix backend"
  }
}
