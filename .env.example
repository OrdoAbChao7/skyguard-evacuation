# 服务端口
PORT=8010

# 数据根目录（默认仓库根目录 data/）
# DATA_ROOT=

# 场景文件：data/scenarios/ 下的文件名，或绝对路径
# 默认演示场景为汉口江滩 MVP（合成/估算数据，44 区域）
SAFETY_SCENARIO_FILE=hankou-mvp.json

# JWT 签名密钥（生产必须显式设置）
SECRET_KEY=replace-with-a-long-random-string

# 首次启动时写入 data/admin_config.json 的管理员账号
SKYGUARD_ADMIN_USERNAME=admin
SKYGUARD_ADMIN_PASSWORD=replace-with-a-strong-password

# 可选：视频感知使用 Python 的路径
# SKYGUARD_PYTHON=python

# 实时视频流（可选）：推荐独立 JSON 文件；data/*.json 已被 .gitignore 忽略。
# 不要把真实地址、用户名、密码、token 提交到仓库。
# 相对路径先按仓库根解析，找不到再按 DATA_ROOT 解析。
# SKYGUARD_STREAMS_FILE=data/streams.json
# 或内联 JSON（适合容器 Secret 注入）：
# SKYGUARD_STREAMS=[{"id":"gate-02","region_id":"R_GATE_02_PLAZA","url":"rtsp://..."}]

# 无人机派发桥接（可选）：默认 outbox 只生成派发包，不发送网络请求。
# 只有 admin / safety_operator 可以显式派发；Agent 不能调用。
# SKYGUARD_DRONE_BRIDGE_MODE=outbox
# SKYGUARD_DRONE_BRIDGE_URL=http://127.0.0.1:9000/dispatch
# SKYGUARD_DRONE_BRIDGE_TOKEN=
# SKYGUARD_DRONE_BRIDGE_TIMEOUT_MS=5000
# SKYGUARD_DRONE_BRIDGE_TTL_MINUTES=15
# SKYGUARD_DRONE_BRIDGE_SIMULATED=true
# SKYGUARD_DRONE_BRIDGE_FILE=drone-dispatches.json

# 可选：工单 JSON 快照（单实例持久化）
# OPS_PERSIST_FILE=data/ops-state.json

# 推荐：统一原子状态（安全/工单/预算/Agent/审计）
# MVP_STATE_FILE=data/mvp-state.json

# HTTP MCP Bearer token；生产未设置时 /mcp 返回 503
# MCP_HTTP_TOKEN=

# AgentArts（无真实租户时保持 AGENT_RUNTIME=local）
# AGENT_RUNTIME=agentarts
# AGENTARTS_CONTRACT=official
# AGENTARTS_RUNTIME_NAME=
# AGENTARTS_INVOKE_RETRIES=1
# AGENTARTS_RETRY_BASE_MS=250

# 安全加固
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
# CORS_ORIGINS=https://your-frontend.example.com
# READ_AUTH_REQUIRED=true
# CSP_ENABLED=true
# TRUST_PROXY=true

# AgentArts 健康探测重试次数（0~3）
# AGENTARTS_HEALTH_RETRIES=1
