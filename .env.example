# 服务端口
PORT=8010

# 数据根目录（默认仓库根目录 data/）
# DATA_ROOT=

# 场景文件：data/scenarios/ 下的文件名，或绝对路径
SAFETY_SCENARIO_FILE=stadium-evacuation.json

# JWT 签名密钥（生产必须显式设置）
SECRET_KEY=replace-with-a-long-random-string

# 首次启动时写入 data/admin_config.json 的管理员账号
SKYGUARD_ADMIN_USERNAME=admin
SKYGUARD_ADMIN_PASSWORD=replace-with-a-strong-password

# 可选：视频感知使用 Python 的路径
# SKYGUARD_PYTHON=python

# 可选：工单 JSON 快照（单实例持久化）
# OPS_PERSIST_FILE=data/ops-state.json

# 推荐：统一原子状态（安全/工单/预算/Agent/审计）
# MVP_STATE_FILE=data/mvp-state.json

# HTTP MCP Bearer token；生产未设置时 /mcp 返回 503
# MCP_HTTP_TOKEN=

# AgentArts（无真实租户时保持 AGENT_RUNTIME=local）
# 生产环境请通过 secret manager 注入，禁止使用示例占位符。
# AGENT_RUNTIME=agentarts
# AGENTARTS_CONTRACT=official
# AGENTARTS_BASE_URL=
# AGENTARTS_API_KEY=
# AGENTARTS_RUNTIME_NAME=
# AGENTARTS_AGENT_ID=
# AGENTARTS_PROJECT_ID=
# AGENTARTS_INVOKE_MODE=published
# AGENTARTS_SESSION_HEADER=x-hw-agentarts-session-id
# AGENTARTS_TIMEOUT_MS=8000
# AGENTARTS_INVOKE_RETRIES=1
# AGENTARTS_RETRY_BASE_MS=250
# AGENTARTS_MAX_STEPS=4
# AGENTARTS_AUTO_CONTINUE=false

# MCP HTTP 身份；staff 经 HTTP 默认禁用
# MCP_ACTOR_ROLE=agent
# MCP_HTTP_ALLOW_STAFF=false

# 安全加固
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
# CORS_ORIGINS=https://your-frontend.example.com
# READ_AUTH_REQUIRED=true
# CSP_ENABLED=true
# TRUST_PROXY=true

# AgentArts 健康探测重试次数（0~3）
# AGENTARTS_HEALTH_RETRIES=1
